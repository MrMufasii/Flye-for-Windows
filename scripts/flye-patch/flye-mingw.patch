-//simple thread pool implementation
+//A persistent pool of DETACHED worker threads, created once and never shut down.
+//
+//Why (Windows / MinGW-w64): when a std::thread exits, the C++ runtime destroys
+//that thread's thread_local objects (the __cxa_thread_atexit path). On MinGW-w64
+//this corrupts the process heap (STATUS_HEAP_CORRUPTION) whenever a thread_local
+//owns heap memory and frees it in its destructor - which is exactly how Flye uses
+//thread_local scratch buffers (k-mer match lists, DP tables, kalloc pools, ...)
+//inside every parallel loop. Upstream created and joined a fresh batch of threads
+//on each processInParallel() call, so those destructors ran constantly and the
+//heap was smashed non-deterministically under load.
+//
+//Reusing a fixed set of workers that are detached and never joined means each
+//worker's thread_locals are constructed once and never destroyed (the OS reclaims
+//them when the process exits), side-stepping the toolchain bug entirely. It is
+//also simply faster than respawning threads for every parallel region.
+class ThreadPool
+{
+public:
+	static ThreadPool& get(size_t numThreads)
+	{
+		//leaked on purpose: the workers must outlive all callers, and must not be
+		//joined/destroyed (see class comment).
+		static ThreadPool* instance = new ThreadPool(numThreads);
+		return *instance;
+	}
+
+	//Runs task(i) for i in [0, count) across the worker threads and blocks until
+	//all have finished. Reentrancy is not supported (Flye never nests these).
+	void run(size_t count, const std::function<void(size_t)>& task)
+	{
+		if (count == 0) return;
+		{
+			std::unique_lock<std::mutex> lock(_mutex);
+			_task = &task;
+			_count = count;
+			_next = 0;
+			_completed = 0;
+			++_batch;
+		}
+		_cvWork.notify_all();
+
+		std::unique_lock<std::mutex> lock(_mutex);
+		_cvDone.wait(lock, [this] {return _completed >= _count;});
+	}
+
+	size_t size() const {return _numThreads;}
+
+private:
+	explicit ThreadPool(size_t numThreads): _numThreads(numThreads)
+	{
+		for (size_t i = 0; i < numThreads; ++i)
+		{
+			std::thread([this] {this->workerLoop();}).detach();
+		}
+	}
+
+	void workerLoop()
+	{
+		size_t myBatch = 0;
+		while (true)
+		{
+			const std::function<void(size_t)>* task;
+			size_t count;
+			{
+				std::unique_lock<std::mutex> lock(_mutex);
+				_cvWork.wait(lock, [this, myBatch] {return _batch != myBatch;});
+				myBatch = _batch;
+				task = _task;
+				count = _count;
+			}
+
+			while (true)
+			{
+				size_t i = _next.fetch_add(1);
+				if (i >= count) break;
+				(*task)(i);
+				if (_completed.fetch_add(1) + 1 >= count)
+				{
+					std::unique_lock<std::mutex> lock(_mutex);
+					_cvDone.notify_all();
+				}
+			}
+		}
+	}
+
+	size_t 					_numThreads;
+	std::mutex 				_mutex;
+	std::condition_variable _cvWork;
+	std::condition_variable _cvDone;
+	const std::function<void(size_t)>* _task = nullptr;
+	size_t 					_count = 0;
+	size_t 					_batch = 0;
+	std::atomic<size_t> 	_next{0};
+	std::atomic<size_t> 	_completed{0};
+};
