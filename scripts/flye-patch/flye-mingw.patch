diff --git a/flye/utils/utils.py b/flye/utils/utils.py
index 41d3aac..e530004 100644
--- a/flye/utils/utils.py
+++ b/flye/utils/utils.py
@@ -19,16 +19,25 @@ def which(program):
     def is_exe(fpath):
         return os.path.isfile(fpath) and os.access(fpath, os.X_OK)
 
+    # On Windows executables carry an extension (.exe/.bat/...). Flye refers to
+    # its helpers by bare name ("flye-modules"), so try the PATHEXT suffixes too.
+    exts = [""]
+    if os.name == "nt":
+        exts += [e.lower() for e in
+                 os.environ.get("PATHEXT", ".EXE;.BAT;.CMD").split(os.pathsep) if e]
+
     fpath, _ = os.path.split(program)
     if fpath:
-        if is_exe(program):
-            return program
+        for ext in exts:
+            if is_exe(program + ext):
+                return program + ext
     else:
         for path in os.environ["PATH"].split(os.pathsep):
             path = path.strip('"')
-            exe_file = os.path.join(path, program)
-            if is_exe(exe_file):
-                return exe_file
+            for ext in exts:
+                exe_file = os.path.join(path, program + ext)
+                if is_exe(exe_file):
+                    return exe_file
 
     return None
 
